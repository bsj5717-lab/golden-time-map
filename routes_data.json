import json
import math
import numpy as np

def clean_num(val, default=None):
    if val is None:
        return default
    try:
        f = float(val)
        return default if (math.isnan(f) or math.isinf(f)) else round(f, 4)
    except Exception:
        return default

routes_export = []
for _, row in successful_df.iterrows():
    # OSRM GeoJSON 좌표는 [경도(lon), 위도(lat)] 순서이므로 Google Maps용 {lat, lng}로 변환
    raw_coords = row.get("경로좌표") or []
    coords_latlng = []
    for c in raw_coords:
        if isinstance(c, (list, tuple)) and len(c) >= 2:
            lat_v = clean_num(c[1])
            lng_v = clean_num(c[0])
            if lat_v is not None and lng_v is not None:
                coords_latlng.append({"lat": lat_v, "lng": lng_v})

    routes_export.append({
        "name": str(row["지정병원명"]),
        "api_name": str(row.get("API병원명", row["지정병원명"])),
        "address": str(row["주소"]),
        "lat": float(row["위도"]),
        "lng": float(row["경도"]),
        "distance_km": float(row["도로거리(km)"]),
        "osrm_minutes": clean_num(row.get("OSRM예상시간(분)"), 0.0),
        "coordinates": coords_latlng
    })

